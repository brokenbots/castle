{
  "apiVersion": "criteria.brokenbots.dev/v1",
  "kind": "CriteriaBinding",
  "images": {
    "shell": "localhost:5000/criteria-adapter-shell-peer-go:0.5.56",
    "copilot": "localhost:5000/criteria-adapter-copilot-peer-go:0.5.56"
  },
  "env": {
    "PATH": "/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin",
    "GOFLAGS": "-mod=readonly",
    "GOPROXY": "https://proxy.golang.org,direct",
    "GOTOOLCHAIN": "local",
    "CRITERIA_TOOL_TIMEOUT": "45m"
  },
  "volumes": [
    {
      "name": "data",
      "kind": "pvc",
      "claim": "criteria-data",
      "mountPath": "/data",
      "env": {
        "CRITERIA_RUN_DIR_ROOT": "/data/.criteria/runs",
        "CRITERIA_SHELL_ALLOWED_PATHS": "/data",
        "CRITERIA_COPILOT_INCLUDE_SENSITIVE_PERMISSION_DETAILS": "1"
      }
    },
    {
      "name": "repo",
      "kind": "pvc",
      "claim": "criteria-repo",
      "mountPath": "/repo"
    },
    {
      "name": "scratch",
      "kind": "tmp",
      "mountPath": "/tmp/scratch",
      "sizeLimit": "8Gi"
    }
  ],
  "secrets": [
    {
      "name": "kanboard-api-key",
      "secretProviderClass": "kanboard-spc",
      "mountPath": "/home/criteria/kanboard-secrets",
      "env": {
        "KANBOARD_APP_TOKEN": "kanboard_app_token",
        "KANBOARD_URL": "kanboard_url"
      }
    },
    {
      "name": "github-tokens",
      "secretProviderClass": "copilot-spc",
      "mountPath": "/home/criteria/secrets",
      "env": {
        "WORKFLOW_GITHUB_TOKEN": "workflow_github_token",
        "REVIEWER_GITHUB_TOKEN": "reviewer_github_token"
      }
    }
  ],
  "config": {
    "baseBranch": "main",
    "ciGateCmd": "go build ./... && go vet ./... && go test ./..."
  }
}
