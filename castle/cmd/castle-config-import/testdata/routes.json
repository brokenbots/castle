    "ticket-cleanup-url": {
      "type": "url",
      "url": "git::https://github.com/brokenbots/workflow-example.git//ticket_cleanup_v1?ref=0b8136650d5622381bf18a597ed93b8c272ba19b",
      "ref": "0b8136650d5622381bf18a597ed93b8c272ba19b",
      "class": "triage",
      "namespace": "criteria-jobs",
      "volumes": [
        {
          "name": "data",
          "kind": "pvc",
          "claim": "criteria-data",
          "mountPath": "/data",
          "env": {
            "CRITERIA_RUN_DIR_ROOT": "/data/.criteria/runs",
            "CRITERIA_SHELL_ALLOWED_PATHS": "/data"
          }
        },
        {
          "name": "repo",
          "kind": "pvc",
          "claim": "criteria-repo",
          "mountPath": "/repo"
        }
      ],
      "secrets": [
        {
          "name": "linear-api-key",
          "secretProviderClass": "linear-spc",
          "mountPath": "/home/criteria/linear-secrets",
          "env": {
            "LINEAR_API_KEY": "linear_api_key"
          }
        },
        {
          "name": "github-tokens",
          "secretProviderClass": "copilot-spc",
          "mountPath": "/home/criteria/secrets"
        }
      ],
      "adapterImages": {
        "shell": "localhost:5000/criteria-adapter-shell-peer:k8s-0.5.56-1",
        "copilot": "localhost:5000/criteria-adapter-copilot-peer:k8s-0.5.56-1"
      },
      "interface": {
        "apiVersion": "criteria.brokenbots.dev/v1",
        "kind": "WorkflowInterface",
        "workflow": "ticket_cleanup_v1",
        "description": "Ticket cleanup: single shell adapter over the Linear API under intake_root (LINEAR_API_KEY via the cleanup adapter secrets block). Mounts: data intake lane plus repo for the cleanup bookkeeping path. Declares no config slots: the tree is fully deterministic.",
        "adapters": [
          "shell"
        ],
        "mounts": [
          {
            "name": "data",
            "mountPath": "/data",
            "kind": "pvc"
          },
          {
            "name": "repo",
            "mountPath": "/repo",
            "kind": "pvc"
          }
        ],
        "secretEnv": [
          "LINEAR_API_KEY"
        ],
        "env": [],
        "configSlots": []
      }
    },
    "kanboard-triage-url": {
      "type": "url",
      "url": "git::https://github.com/brokenbots/workflow-example.git//kanboard_triage_v1?ref=63535719e37750301a8b7cc9be2c74b2d18c847e",
      "ref": "63535719e37750301a8b7cc9be2c74b2d18c847e",
      "class": "triage",
      "namespace": "criteria-jobs",
      "volumes": [
        {
          "name": "data",
          "kind": "pvc",
          "claim": "criteria-data",
          "mountPath": "/data",
          "env": {
            "CRITERIA_RUN_DIR_ROOT": "/data/.criteria/runs",
            "CRITERIA_SHELL_ALLOWED_PATHS": "/data",
            "CRITERIA_COPILOT_INCLUDE_SENSITIVE_PERMISSION_DETAILS": "1"
          }
        },
        {
          "name": "repo",
          "kind": "pvc",
          "claim": "criteria-repo",
          "mountPath": "/repo"
        },
        {
          "name": "scratch",
          "kind": "tmp",
          "mountPath": "/tmp/scratch",
          "sizeLimit": "8Gi"
        }
      ],
      "secrets": [
        {
          "name": "github-tokens",
          "secretProviderClass": "copilot-spc",
          "mountPath": "/home/criteria/secrets",
          "env": {
            "WORKFLOW_GITHUB_TOKEN": "workflow_github_token"
          }
        },
        {
          "name": "kanboard-secrets",
          "secretProviderClass": "kanboard-spc",
          "mountPath": "/home/criteria/kanboard-secrets",
          "env": {
            "KANBOARD_APP_TOKEN": "kanboard_app_token",
            "KANBOARD_URL": "kanboard_url"
          }
        }
      ],
      "adapterImages": {
        "shell": "localhost:5000/criteria-adapter-shell-peer:k8s-0.5.56-1",
        "copilot": "localhost:5000/criteria-adapter-copilot-peer:k8s-0.5.56-1"
      },
      "interface": {
        "apiVersion": "criteria.brokenbots.dev/v1",
        "kind": "WorkflowInterface",
        "workflow": "kanboard_triage_v1",
        "description": "Triage lane: investigator/supervisor tree plus locked qa_triage_v1/review_output subworkflows (copilot+shell). Mounts and secret lanes mirror the shipped kanboard-triage-url binding (no reviewer token: the tree declares no reviewer secret var). build_cmd/test_cmd drive the investigator repro checks.",
        "adapters": [
          "copilot",
          "shell"
        ],
        "mounts": [
          {
            "name": "data",
            "mountPath": "/data",
            "kind": "pvc"
          },
          {
            "name": "repo",
            "mountPath": "/repo",
            "kind": "pvc"
          },
          {
            "name": "scratch",
            "mountPath": "/tmp/scratch",
            "kind": "tmp"
          }
        ],
        "secretEnv": [
          "KANBOARD_APP_TOKEN",
          "KANBOARD_URL",
          "WORKFLOW_GITHUB_TOKEN"
        ],
        "env": [],
        "configSlots": [
          {
            "slot": "buildCmd",
            "variable": "build_cmd",
            "target": "qa_triage repro checks (build)",
            "description": "Command the repro build leg runs against the fetched repo."
          },
          {
            "slot": "testCmd",
            "variable": "test_cmd",
            "target": "qa_triage repro checks (test)",
            "description": "Command the repro test leg runs against the fetched repo."
          }
        ]
      }
    },
