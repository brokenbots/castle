FROM golang:1.26-alpine AS build

WORKDIR /src
COPY go.work ./
COPY castle/ ./castle/
COPY criteria-sdk/ ./criteria-sdk/

WORKDIR /src/castle
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/criteria-test-agent ./cmd/criteria-test-agent

FROM alpine:3.20

RUN adduser -D -u 10001 app && mkdir -p /var/lib/agent && chown -R app:app /var/lib/agent && \
    apk add --no-cache procps

WORKDIR /app
COPY --from=build /out/criteria-test-agent /usr/local/bin/criteria-test-agent

USER app
ENTRYPOINT ["criteria-test-agent"]
