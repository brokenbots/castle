FROM golang:1.26-alpine AS build
# go.work pins a newer patch than this base image ships; let the toolchain
# self-update instead of failing with GOTOOLCHAIN=local errors.
ENV GOTOOLCHAIN=auto

WORKDIR /src
COPY . .

RUN cd castle && CGO_ENABLED=0 GOOS=linux go build -o /out/castle ./cmd/castle

FROM alpine:3.20

RUN adduser -D -u 10001 app && mkdir -p /data && chown -R app:app /data

WORKDIR /app
COPY --from=build /out/castle /usr/local/bin/castle

EXPOSE 8080
VOLUME ["/data"]

USER app
ENTRYPOINT ["castle"]
